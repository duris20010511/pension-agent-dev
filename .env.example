# CLOVA Studio (HyperCLOVA X) — 콘솔 > CLOVA Studio > [API 키] 에서 발급
CLOVA_API_KEY=nv-여기에_키를_붙여넣으세요

# 채팅 모델. HCX-007(추론) 채택.
# 100문항 실측: 체크리스트 83.8%, 함정 대응 97.4%, 할루시네이션 0.0%
# HCX-007 은 maxCompletionTokens 를 쓰고 thinkingContent 를 별도 반환한다 (clova.chat_thinking)
CLOVA_CHAT_MODEL=HCX-007

# 임베딩 v2(bge-m3) — 경로에는 모델명이 아니라 "v2". 8,192토큰 / 1,024차원
CLOVA_EMBED_MODEL=v2

# 404 가 나면 앱 종류에 따라 아래로 바꿔볼 것
# CLOVA_BASE=https://clovastudio.stream.ntruss.com/testapp
CLOVA_BASE=https://clovastudio.stream.ntruss.com

# --- 아래는 기본값이 있어 설정하지 않아도 된다 (조정용) ---
# AGENT_SAMPLES=3        초안 개수. 부하가 있으면 서버가 자동으로 줄인다
# AGENT_TOPK=8           근거 문서 수. 20→8 로 줄여도 품질은 동급(+1.75pp, t=0.83)이고 호출은 절반으로 빨라진다
# AGENT_MAXTOK=2048      추론+답변 상한. 4096 대비 31% 빠르고 답변은 잘리지 않는다
# AGENT_CONCURRENCY=16   동시 처리 상한
# AGENT_PER_CALL_S=20    호출당 시간의 하한. 서버가 실제 호출을 재서 쓰므로 표본 5개 미만일 때만 쓰인다
