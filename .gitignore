# 비밀
.env

# 파이썬
__pycache__/
*.pyc

# 색인·임베딩 캐시 (93MB). Docker 이미지에는 포함되지만 저장소에는 넣지 않는다.
.cache/

# 주최측 원본 자료와 배포 산출물.
#
# 한글 디렉터리명("2.연금")으로 무시하려 했다가 크게 데었다 — 유니코드 정규화
# (NFC/NFD) 불일치로 패턴이 매칭되지 않아 159MB 원본이 전 커밋에 들어갔고,
# 확인에 쓴 grep 도 같은 패턴이라 0건을 반환해 잘못된 안심을 줬다.
# 그래서 한글 경로에 의존하지 않는 규칙으로 바꾼다.
*.zip
*.pdf
*.tar.gz

# 로컬 도구 설정
.claude/

# 운영 로그(질의 기록). 개인정보 꼴 숫자는 가리지만 저장소에는 넣지 않는다.
logs/

# 배포 묶음(deploy/deploy.sh pack)
deploy/*.tar.gz
