  {"id": "R-02", "name": "세액공제율", "condition": "총급여 ≤ 5,500만 원 (또는 종합소득 ≤ 4,500만 원) → 16.5%, 초과 → 13.2%",
   "docs": [1, 27, 41], "status": "✅",
   "applies_to": ["account.savings", "account.irp"], "conditions": [{"attr": "attr.income", "test": "≤ 5,500만 원(총급여) / 4,500만 원(종합소득)"}]},
  {"id": "R-03", "name": "ISA 만기 전환 추가 공제", "condition": "전환 금액의 10%, 최대 300만 원 추가 공제",
