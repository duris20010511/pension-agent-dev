  {"id": "R-05", "name": "연금수령한도", "condition": "평가액 ÷ (11 − 연금수령연차) × 120%. 2013.3.1 전 가입 계좌는 6년차부터 기산",
   "docs": [1, 2, 21, 39], "status": "✅",
   "applies_to": ["wd.pension", "wd.other", "account.savings", "account.irp"],
   "conditions": [{"attr": "attr.balance"}, {"attr": "attr.year_n", "test": "11년차부터 한도 없음"}, {"attr": "attr.open_date", "test": "2013.3.1 전 가입이면 6년차부터"}]},
  {"id": "R-06", "name": "인출 순서", "condition": "① 과세제외금액 → ② 이연퇴직소득 → ③ 세액공제 받은 납입금·운용수익",
   "docs": [1, 4, 5, 6, 21, 22, 26, 39, 44], "status": "✅",
   "applies_to": ["fund.free", "fund.retire", "fund.credit"], "conditions": [{"attr": "attr.fund_amount", "test": "재원이 둘 이상일 때"}]},
  {"id": "R-07", "name": "연금소득세율", "condition": "(③ 재원 × 연금수령) 55~69세 5.5%, 70~79세 4.4%, 80세 이상 3.3%",
