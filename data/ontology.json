   "conditions": [{"attr": "attr.retire_tax", "test": "② 재원이 연금외수령될 때"}]},
  {"id": "R-11", "name": "부득이한 사유 인출", "condition": "부득이한 사유면 중도 인출이어도 연금소득세 3.3~5.5%",
